[Unit]
Description=codeg local model router (:8899 OpenCode Go, :8898 DeepSeek, :8897 Volcengine Ark)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/opencode-go-proxy.env
ExecStart=/usr/local/bin/opencode-go-proxy
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
