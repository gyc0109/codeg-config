[Unit]
Description=OpenCode Go OpenAI-compatible shim (injects x-opencode-session)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/opencode-go-proxy.env
ExecStart=/usr/local/bin/opencode-go-proxy
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
