#!/usr/bin/env python3
"""codeg 本机路由（:8899）：按模型名前缀分流到不同上游。

  ocg/<id>  ->  https://opencode.ai/zen/go        （OpenCode Go，注入会话头 + key）
  ds/<id>   ->  https://api.deepseek.com          （DeepSeek 官方，注入 Bearer）
  <id>      ->  OpenCode Go（无前缀，向后兼容旧行为）

OpenCode Go 会拒绝任何不带 session 头（x-opencode-session / session_id /
x-session-id）的请求，多数 agent 不会发这个头，所以这里为 ocg 注入。

上游响应头原样转发、body 逐块透传，保证 chunked SSE 与普通 JSON 都能被客户端
正常解析。

DeepSeek 官方 key 读自环境变量 DEEPSEEK_OFFICIAL_API_KEY 或
/etc/deepseek-official-key。
"""
import json
import os
import re
import socket
import ssl
import sys
import threading
import uuid

LISTEN_HOST = os.environ.get("OGP_HOST", "127.0.0.1")
LISTEN_PORT = int(os.environ.get("OGP_PORT", "8899"))

# 每个上游一个端口：裸模型名也能正确路由（前缀路由保留在 8899 上做兼容）
# 注意：8898 已被 commandcode-proxy 占用，DeepSeek 用 8896
PORT_UPSTREAM = {
    8899: "ocg",
    8896: "ds",
    8897: "ark",
}

OGP_HOST = "opencode.ai"
OGP_BASE = "/zen/go/v1"
OGP_KEY = os.environ.get("OPENCODE_GO_API_KEY", "").strip()

DS_HOST = "api.deepseek.com"
DS_BASE = "/v1"
DS_KEY = os.environ.get("DEEPSEEK_OFFICIAL_API_KEY", "").strip()
DS_KEY_FILE = os.environ.get("DEEPSEEK_OFFICIAL_KEY_FILE", "/etc/deepseek-official-key")

ARK_HOST = "ark.cn-beijing.volces.com"
ARK_BASE = "/api/v3"
ARK_KEY = os.environ.get("VOLCENGINE_ARK_API_KEY", "").strip()
ARK_KEY_FILE = os.environ.get("VOLCENGINE_ARK_KEY_FILE", "/etc/volcengine-ark-key")
if not ARK_KEY and os.path.exists(ARK_KEY_FILE):
    with open(ARK_KEY_FILE) as fh:
        ARK_KEY = fh.read().strip()
if not DS_KEY and os.path.exists(DS_KEY_FILE):
    with open(DS_KEY_FILE) as fh:
        DS_KEY = fh.read().strip()

SESSION = os.environ.get("OGP_SESSION", "ses_codeg_proxy")
PROJECT = os.environ.get("OGP_PROJECT", "global")

_HOP = {
    b"host",
    b"connection",
    b"content-length",
    b"authorization",
    b"x-api-key",
    b"accept",
    b"accept-encoding",
}


def _read_headers(sock):
    data = b""
    while b"\r\n\r\n" not in data:
        chunk = sock.recv(65536)
        if not chunk:
            return None
        data += chunk
    return data


def _read_body(sock, head_rest, content_length):
    body = head_rest
    while len(body) < content_length:
        chunk = sock.recv(65536)
        if not chunk:
            break
        body += chunk
    return body


def _split_model(body):
    """返回 (prefix, wire_model)；body 不是 JSON 或没有 model 时 prefix 为 None。"""
    if not body:
        return None, None
    try:
        doc = json.loads(body)
    except (ValueError, TypeError):
        return None, None
    if not isinstance(doc, dict):
        return None, None
    model = doc.get("model")
    if not isinstance(model, str):
        return None, None
    if model.startswith("ocg/"):
        return "ocg", model[4:]
    if model.startswith("ds/"):
        return "ds", model[3:]
    if model.startswith("ark/"):
        return "ark", model[4:]
    if model.startswith("ocg/"):
        return "ocg", model[4:]
    # 裸模型名：交给调用方按监听端口决定上游，并原样发送（不剥任何东西）
    return None, model


def _normalize_roles(body):
    """把 messages[].role == "developer" 改成 "system"。
    OpenAI 兼容网关里 developer 是较新的角色，部分上游（DeepSeek 官方、火山方舟）
    只认 system/user/assistant/tool，不转换会 422。"""
    try:
        doc = json.loads(body)
    except (ValueError, TypeError):
        return body
    if not isinstance(doc, dict):
        return body
    msgs = doc.get("messages")
    if not isinstance(msgs, list):
        return body
    changed = False
    for m in msgs:
        if isinstance(m, dict) and m.get("role") == "developer":
            m["role"] = "system"
            changed = True
    return json.dumps(doc).encode() if changed else body


def _strip_prefix(body, wire):
    try:
        doc = json.loads(body)
        doc["model"] = wire
        return json.dumps(doc).encode()
    except (ValueError, TypeError):
        return body


def handle(client, listen_port=8899):
    upstream = None
    try:
        data = _read_headers(client)
        if data is None:
            return
        head, _, rest = data.partition(b"\r\n\r\n")
        lines = head.split(b"\r\n")
        parts = lines[0].split(b" ")
        if len(parts) < 3:
            return
        method, path = parts[0].decode(), parts[1].decode()

        content_length = 0
        kept = []
        for line in lines[1:]:
            if b":" not in line:
                continue
            k, v = line.split(b":", 1)
            kl = k.strip().lower()
            if kl == b"content-length":
                content_length = int(v.strip())
                continue
            if kl in _HOP:
                continue
            kept.append((k.strip(), v.strip()))

        body = _read_body(client, rest, content_length)

        prefix, wire = _split_model(body)
        # 裸模型名（没有前缀）时，用监听端口决定上游
        if prefix is None:
            prefix = PORT_UPSTREAM.get(listen_port, "ocg")
            if body:
                try:
                    _d = json.loads(body)
                    if isinstance(_d, dict) and isinstance(_d.get("model"), str):
                        wire = _d["model"]
                except (ValueError, TypeError):
                    pass
            if prefix != "ocg":
                body = _strip_prefix(body, wire)
        if prefix == "ark":
            if not ARK_KEY:
                client.sendall(b"HTTP/1.1 500 Internal Server Error\r\n"
                               b"Content-Type: application/json\r\nContent-Length: 58\r\n\r\n"
                               b'{"error":{"type":"proxy_error","message":"Ark key missing"}}')
                return
            host, base, key = ARK_HOST, ARK_BASE, ARK_KEY
            if wire is not None:
                body = _strip_prefix(body, wire)
            body = _normalize_roles(body)
        elif prefix == "ds":
            if not DS_KEY:
                client.sendall(b"HTTP/1.1 500 Internal Server Error\r\n"
                               b"Content-Type: application/json\r\nContent-Length: 62\r\n\r\n"
                               b'{"error":{"type":"proxy_error","message":"DeepSeek key missing"}}')
                return
            host, base, key = DS_HOST, DS_BASE, DS_KEY
            body = _strip_prefix(body, wire)
            body = _normalize_roles(body)
        else:
            host, base, key = OGP_HOST, OGP_BASE, OGP_KEY
            if wire is not None and wire != "":  # ocg/<id> 也要剥掉前缀
                body = _strip_prefix(body, wire)

        target_path = base + (path[3:] if path.startswith("/v1") else path)

        upstream = ssl.create_default_context().wrap_socket(
            socket.create_connection((host, 443), timeout=30), server_hostname=host)
        # 30s 只用于建连；模型推理经常更久，读写要放宽（否则 read timeout）
        upstream.settimeout(float(os.environ.get("OGP_IO_TIMEOUT", "900")))
        req = [f"{method} {target_path} HTTP/1.1".encode(), f"Host: {host}".encode()]
        if key:
            req.append(f"Authorization: Bearer {key}".encode())
        if prefix not in ("ds", "ark"):
            if key:
                req.append(f"x-api-key: {key}".encode())
            req.append(f"x-opencode-session: {SESSION}".encode())
            req.append(b"x-opencode-client: cli")
            req.append(f"x-opencode-project: {PROJECT}".encode())
        for k, v in kept:
            req.append(k + b": " + v)
        req.append(b"Content-Length: " + str(len(body)).encode())
        req.append(b"")
        req.append(b"")
        upstream.sendall(b"\r\n".join(req) + body)

        head = b""
        while b"\r\n\r\n" not in head:
            chunk = upstream.recv(65536)
            if not chunk:
                break
            head += chunk
        if head:
            # 我们处理完就关 socket，不能让客户端以为连接可复用（否则下一次
            # 复用已关闭的连接会报 Connection error）。所以显式声明 close。
            rh, _, rbody = head.partition(b"\r\n\r\n")
            rh = re.sub(rb"\r\nConnection:[^\r\n]*", b"", rh, flags=re.I)
            rh = re.sub(rb"\r\nKeep-Alive:[^\r\n]*", b"", rh, flags=re.I)
            client.sendall(rh + b"\r\nConnection: close\r\n\r\n" + rbody)
            while True:
                chunk = upstream.recv(65536)
                if not chunk:
                    break
                client.sendall(chunk)
    except Exception as exc:  # noqa: BLE001 - a proxy must never die on one conn
        sys.stderr.write(f"codeg-proxy: {exc!r}\n")
        sys.stderr.flush()
    finally:
        for s in (upstream, client):
            if s is not None:
                try:
                    s.close()
                except OSError:
                    pass


UPSTREAM_INFO = {
    "ocg": lambda: f"https://{OGP_HOST}{OGP_BASE}",
    "ds": lambda: f"https://{DS_HOST}{DS_BASE or '/v1'}",
    "ark": lambda: f"https://{ARK_HOST}{ARK_BASE}",
}


def serve(port):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind((LISTEN_HOST, port))
    except OSError as exc:
        sys.stderr.write(f"codeg-proxy :{port} BIND FAILED: {exc!r}\n")
        sys.stderr.flush()
        return
    srv.listen(128)
    up = PORT_UPSTREAM.get(port, "ocg")
    extra = " (裸模型名也走这条 + 支持 ocg/ 等前缀)" if up == "ocg" else " (裸模型名走这条)"
    sys.stderr.write(f"codeg-proxy :{port} -> {UPSTREAM_INFO[up]()}{extra}\n")
    sys.stderr.flush()
    while True:
        conn, _ = srv.accept()
        threading.Thread(target=handle, args=(conn, port), daemon=True).start()


def main():
    ports = sorted(PORT_UPSTREAM)
    threads = [threading.Thread(target=serve, args=(p,), daemon=True) for p in ports]
    for th in threads:
        th.start()
    sys.stderr.write(f"codeg-proxy up on {', '.join(str(p) for p in ports)}\n")
    sys.stderr.flush()
    threads[0].join()


if __name__ == "__main__":
    main()
